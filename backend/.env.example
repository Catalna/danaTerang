# Copy to .env for local development and fill in values locally. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://danaterang_dev:URL_ENCODED_LOCAL_PASSWORD@127.0.0.1:5432/danaterang
# Hosted Postgres (Supabase pooler etc.): set to false when the provider CA chain is not in Node's trust store; prefer DATABASE_SSL_ROOT_CERT for strict verification.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_SSL_ROOT_CERT=
WEB_ORIGIN=http://localhost:3000
AUTO_MIGRATE=false
LOCAL_OBJECT_STORAGE_ROOT=../.local/evidence
MAX_EVIDENCE_BYTES=10485760
STORAGE_MODE=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false
# Local folder containing uncompressed eng.traineddata and ind.traineddata; keep model files untracked.
OCR_LANGUAGE_DATA_PATH=../.local/tessdata
OCR_POLL_INTERVAL_MS=1000
OCR_JOB_LEASE_MS=300000
OCR_MAX_ATTEMPTS=3
OCR_MAX_PDF_PAGES=10
OCR_RENDER_DPI=150
OCR_MAX_IMAGE_PIXELS=25000000
OCR_VENDOR_CONFIDENCE_THRESHOLD=70
OCR_DOCUMENT_DATE_CONFIDENCE_THRESHOLD=80
OCR_AMOUNT_CONFIDENCE_THRESHOLD=90
OCR_INVOICE_CONFIDENCE_THRESHOLD=70

# Optional AI enrichment; the local OCR pipeline also works with this disabled.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_PAGES=4
GEMINI_RETRIES=1
GEMINI_FIELD_THRESHOLD=80
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_COOLDOWN_MS=60000

# Ethereum Sepolia service wallet; set only in a private local .env or staging secret store.
PEER_REVIEW_CONTRACT_ADDRESS=
# Updated CampaignRegistry deployment containing lockCampaignTerms; required for Organizer H-48 terms signing.
CAMPAIGN_REGISTRY_ADDRESS=
# ProofAnchor contract for canonical proof commitments; anchoring stays disabled when unset.
PROOF_ANCHOR_CONTRACT_ADDRESS=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
# The initial three Verifier addresses and Organization commitments are fixed in the contract constructor.
CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_EXPLORER_URL=https://sepolia.etherscan.io

# Public fundraising checkout/refund/payout is disabled until a payment/escrow
# provider adapter is selected, implemented, and configured with verified webhooks.

# Used only by `npm run admin:provision --workspace @dana-terang/api`.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Supabase / hosted PostgreSQL -----------------------------------------
# A connection string from Supabase already carries sslmode=require; keep it.
# Use the SESSION pooler / direct endpoint (port 5432) when running migrations,
# and the TRANSACTION pooler (port 6543) for the long-running API. URL-encode
# the database password. See database/supabase/README.md.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Lower this on serverless so multiple instances stay under the pooler limit.
DATABASE_POOL_MAX=5

# Local file storage does not survive a Vercel deployment. Point the API at
# Supabase Storage's S3-compatible endpoint (or any S3 bucket) in production:
# STORAGE_MODE=s3
# STORAGE_BUCKET=evidence
# STORAGE_ENDPOINT=https://[PROJECT_REF].storage.supabase.co/storage/v1/s3
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=local
# STORAGE_FORCE_PATH_STYLE=true

