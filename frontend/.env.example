# Next.js proxies same-origin /api requests to the backend server.
API_INTERNAL_URL=http://127.0.0.1:4000

# Optional client-side overrides (rarely needed; defaults work with the proxy above):
# NEXT_PUBLIC_API_BASE_URL=          # absolute API base when the browser must call the API directly
# NEXT_PUBLIC_REVIEW_CHAIN_ID=11155111  # chain of the peer-review contract (default Sepolia)
# NEXT_PUBLIC_BLOCKCHAIN_EXPLORER_URL=https://sepolia.etherscan.io  # tx explorer for public proofs

# Supabase project client credentials (isikan nilai dari Supabase Dashboard → Project Settings → API).
# Catatan: aplikasi saat ini TIDAK memakai keduanya — database diakses backend lewat
# DATABASE_URL (connection string Postgres), bukan lewat Supabase JS client.
# Kedua variabel disiapkan untuk pemakaian client-side berikutnya (mis. Supabase Storage/Realtime).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
